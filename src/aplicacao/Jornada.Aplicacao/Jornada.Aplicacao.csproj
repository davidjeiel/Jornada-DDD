       dependência e faz o hexágono funcionar (ADR-0001).
       Também sem <PackageReference>: só o domínio. -->

  <PropertyGroup>
    <RootNamespace>Jornada.Aplicacao</RootNamespace>
    <AssemblyName>Jornada.Aplicacao</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\dominio\Jornada.Dominio\Jornada.Dominio.csproj" />
  </ItemGroup>

</Project>
