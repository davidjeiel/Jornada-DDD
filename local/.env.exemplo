# Copie para local/.env e ajuste. local/.env esta no .gitignore.
#
# Nada aqui e segredo de verdade: sao credenciais de brinquedo de um ambiente
# que so escuta em localhost. Em producao nao existe arquivo como este --
# a aplicacao usa Managed Identity e Key Vault (ADR-0011), sem senha nenhuma.
# Se voce algum dia precisar de um segredo REAL aqui, esta fazendo errado.

# -- Containers --------------------------------------------------------------
MSSQL_SA_PASSWORD=Dev_Local_Senha_Forte_1
KEYCLOAK_ADMIN_PASSWORD=admin

# -- Aplicacao ---------------------------------------------------------------
# Cosmos DB (ADR-0016). A chave e a PUBLICA do emulador, documentada pela
# Microsoft; conta real usa identidade gerenciada, sem chave nenhuma.
Persistencia__Provedor=cosmos
ConnectionStrings__Cosmos=AccountEndpoint=https://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
Cosmos__Emulador=true

ConnectionStrings__Redis=localhost:6379
ConnectionStrings__Blob=UseDevelopmentStorage=true
ConnectionStrings__ServiceBus=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# -- Identidade (Keycloak no lugar do Entra -- ADR-0013) ---------------------
Identidade__Autoridade=http://localhost:8080/realms/catalogo-local
Identidade__ClienteSpa=catalogo-spa
Identidade__ClienteApi=catalogo-api
Identidade__SegredoApi=dev-segredo-local-nao-use-em-producao

# -- Observabilidade ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18889
OTEL_SERVICE_NAME=jornada-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# -- Busca -------------------------------------------------------------------
# A busca ainda roda sobre consultas do proprio Cosmos (ADR-0016): nao ha
# emulador de Azure AI Search. Troque para "opensearch" so quando estiver
# mexendo num adaptador de busca, e suba com --profile busca.
Busca__Provedor=cosmos

# -- Podman ------------------------------------------------------------------
# Aspire nao assume Podman; precisa que voce diga.
ASPIRE_CONTAINER_RUNTIME=podman

# Testcontainers (ADR-0013). No Windows, com Docker Compatibility ligado
# no Podman Desktop. Em Linux: unix:///run/user/$UID/podman/podman.sock
DOCKER_HOST=npipe:////./pipe/docker_engine
TESTCONTAINERS_RYUK_DISABLED=true
