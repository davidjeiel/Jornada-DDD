{
  "realm": "catalogo-local",
  "displayName": "Catálogo DDD — local",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,

  "_comentario": [
    "Realm de DESENVOLVIMENTO. Não é Entra External ID (ADR-0007) — é OIDC",
    "padrão, que é o que a porta IProvedorDeIdentidade consome. O adaptador",
    "muda por configuração; o domínio não sabe a diferença.",
    "",
    "O que NÃO se testa aqui, e precisa de homologação com Entra real:",
    "federação com o IdP do cliente, passkeys/FIDO2 e políticas de MFA.",
    "",
    "O claim que importa é tid_empresa. Ele é o insumo do ContextoDeTenant",
    "(ADR-0003) — e, ainda assim, o servidor valida contra o control plane",
    "em vez de confiar no token."
  ],

  "clients": [
    {
      "clientId": "catalogo-spa",
      "name": "SPA React (BFF / PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "https://localhost:7001/*"],
      "webOrigins": ["http://localhost:5173", "https://localhost:7001"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "tid_empresa",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tid_empresa",
            "claim.name": "tid_empresa",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "catalogo-api",
      "name": "API pública — client_credentials (integrações, CI/CD)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-segredo-local-nao-use-em-producao",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "_nota": "Credencial de máquina tem tid_empresa FIXO e nunca é reapontada (ADR-0007 §5)"
      },
      "protocolMappers": [
        {
          "name": "tid_empresa",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tid_empresa",
            "claim.value": "11111111-1111-1111-1111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "curador.a",
      "email": "curador.a@empresa-a.local",
      "firstName": "Curadora",
      "lastName": "da Empresa A",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tid_empresa": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [{ "type": "password", "value": "dev", "temporary": false }]
    },
    {
      "username": "arquiteto.a",
      "email": "arquiteto.a@empresa-a.local",
      "firstName": "Arquiteto",
      "lastName": "da Empresa A",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tid_empresa": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [{ "type": "password", "value": "dev", "temporary": false }]
    },
    {
      "username": "curador.b",
      "email": "curador.b@empresa-b.local",
      "firstName": "Curador",
      "lastName": "da Empresa B",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tid_empresa": ["22222222-2222-2222-2222-222222222222"] },
      "credentials": [{ "type": "password", "value": "dev", "temporary": false }]
    }
  ]
}
